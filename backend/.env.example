# Copier ce fichier en .env et renseigner les vraies valeurs.
# NE JAMAIS committer le .env réel (secrets) dans git.

# Base applicative du catalogue (SQLite en local, PostgreSQL en production)
DATABASE_URL=sqlite:///./catalogue.db

# Snowflake - compte de service partagé avec l'agent Agile
SNOWFLAKE_ACCOUNT=safran-sed_space
SNOWFLAKE_HOST=safran-sed_space.privatelink.snowflakecomputing.com
SNOWFLAKE_USER=GS3_SERVICE_USER
SNOWFLAKE_PRIVATE_KEY_FILE=./secrets/rsa_GS4_key.p8
SNOWFLAKE_PRIVATE_KEY_PWD=
SNOWFLAKE_ROLE=RF_GS3_ANALYST
SNOWFLAKE_WAREHOUSE=WH_GS3
SNOWFLAKE_DATABASE=PRD_RAW_PLM_AGILE
SNOWFLAKE_SCHEMA=AGILE

# ATTID AGILE_FLEX portant la référence commerciale (à identifier via discover_agile.py)
AGILE_COMMERCIAL_REF_ATTID=
